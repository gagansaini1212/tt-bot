# The execution worker and the web app connect as this role. Row-level
# security applies to it, so it must not be a superuser or own the tables. For
# local development, pnpm db:seed creates it. See docs/database.md.
DATABASE_URL=postgresql://trading_local:trading_local@localhost:5432/trading
# The schema's owner. Only pnpm db:migrate and pnpm db:seed use it.
DATABASE_ADMIN_URL=postgresql://trading:trading@localhost:5432/trading
# Signs customers' session cookies and the assistant's customer tokens. The
# example value works locally only. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
LIVE_TRADING_ENABLED=false
MODEL_PROVIDER=fixture
NEWS_PROVIDER=fixture
# The analysis assistant's own token for the execution worker. It records AI
# decisions and nothing else. The worker and eve both read it from this file.
# Generate it with openssl rand -hex 32; it must differ from
# EXECUTION_API_TOKEN. Leave it empty and the assistant's proposals are not
# saved. Set EXECUTION_API_URL here too if the worker is not on port 4001.
EXECUTION_ASSISTANT_TOKEN=
