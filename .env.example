# The execution worker connects as this role. Row-level security applies to
# it, so it must not be a superuser or own the tables. For local development,
# pnpm db:seed creates it. See docs/database.md.
DATABASE_URL=postgresql://trading_local:trading_local@localhost:5432/trading
# The schema's owner. Only pnpm db:migrate and pnpm db:seed use it.
DATABASE_ADMIN_URL=postgresql://trading:trading@localhost:5432/trading
AUTH_SECRET=replace-with-at-least-32-random-characters
LIVE_TRADING_ENABLED=false
MODEL_PROVIDER=fixture
NEWS_PROVIDER=fixture
