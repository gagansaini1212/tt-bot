# Read access to the local execution service. Binance credentials belong in apps/execution/.env only.
EXECUTION_API_URL=http://127.0.0.1:4001
EXECUTION_API_TOKEN=
# The web app also reads DATABASE_URL and AUTH_SECRET from the repository's
# .env, for customer sign-in. Values set here win.
# Optional. Where backtests keep downloaded Binance candles. Defaults to .market-history in the working directory.
# MARKET_HISTORY_CACHE_DIR=
