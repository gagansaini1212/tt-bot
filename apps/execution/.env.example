# Register a public key at https://testnet.binance.vision/.
EXCHANGE_PROVIDER=binance-spot-testnet
# Seals the exchange keys and webhook URLs saved on the Settings page
# (AES-256-GCM). It has no default: without it, nothing can be saved there.
# Generate using: openssl rand -base64 32
# Keep it with your backups: saved keys cannot be opened without it.
CREDENTIALS_MASTER_KEY=
# The worker's own keys. Keys saved in Settings replace them for the dev
# customer's testnet account; these serve it until then.
BINANCE_TESTNET_API_KEY=
# Absolute path to the corresponding Ed25519 or RSA private PEM key.
BINANCE_TESTNET_PRIVATE_KEY_PATH=
# Alternative for HMAC API keys. Leave empty when using a private key.
BINANCE_TESTNET_API_SECRET=
# Dashboard orders stay off until these are set, and until you set your risk
# limits (per-order cap, daily risk limit, default stop loss) in Settings.
# They have no defaults.
# Markets the dashboard may buy: BTC-USDT, ETH-USDT or both.
TESTNET_MANUAL_INSTRUMENTS=BTC-USDT,ETH-USDT
# Total virtual USDT that open dashboard entries and the positions their exits
# protect may hold at once.
TESTNET_MANUAL_ALLOCATION_USDT=300
# How far above the best ask, in percent, a market buy may pay (at most 5).
# Leave empty to turn market orders off.
TESTNET_MARKET_MAX_SLIPPAGE_PERCENT=0.5
EXECUTION_PORT=4001
# The worker also reads DATABASE_URL from the repository's .env. See
# docs/database.md.
# Generate using: openssl rand -hex 32
# Copy the same token to apps/web/.env.local. Never use a NEXT_PUBLIC_ variable.
EXECUTION_API_TOKEN=
